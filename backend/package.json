    "pg": "^8.12.0",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "jest": "^29.7.0",
    "jest-html-reporters": "^3.1.7",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2",
    "testcontainers": "^10.16.0",
    "vitest": "^3.2.4"
